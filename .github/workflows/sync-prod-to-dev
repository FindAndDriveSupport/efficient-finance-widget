name: Sync Prod to Dev (One-Off)

# ONE-OFF, manually-triggered mirror of e-fficient-finance-widget (prod)
# INTO e-fficient-finance-widget-dev — the reverse of the normal dev->prod
# flow. THIS IS DESTRUCTIVE: dev's tracked files (except the excludes below)
# get overwritten to exactly match prod. No PR, no review step, straight
# push to dev's main. Lives in the PROD repo's .github/workflows/ — trigger
# it manually via Actions tab or `gh workflow run`, requires typing "yes"
# into the confirm input, will not run without it.
#
# This is NOT meant to run on a schedule or automatically on push — by
# design, unlike sync-from-dev.yml / sync-template-to-dealer.yml. If this
# ever needs to become a recurring thing rather than a one-off, that's worth
# a deliberate follow-up decision, not something to casually add a `push`
# trigger to later.

on:
  workflow_dispatch:
    inputs:
      confirm:
        description: 'Type exactly "yes" to confirm — this OVERWRITES dev to match prod.'
        required: true

jobs:
  sync:
    runs-on: ubuntu-latest
    if: github.event.inputs.confirm == 'yes'
    steps:
      - name: Abort if not confirmed
        if: github.event.inputs.confirm != 'yes'
        run: |
          echo "❌ Confirmation input must be exactly 'yes'. Aborting without making any changes."
          exit 1

      - name: Checkout prod repo (e-fficient-finance-widget)
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GH_PAT }}
          path: prod

      - name: Checkout dev repo (e-fficient-finance-widget-dev)
        uses: actions/checkout@v4
        with:
          repository: FindAndDriveSupport/e-fficient-finance-widget-dev
          token: ${{ secrets.GH_PAT }}
          path: dev

      - name: Mirror prod into dev
        run: |
          # Excludes kept as-is on dev:
          #   .github/                            - recurring source of drift between repos
          #   wrangler.toml                       - dev's Worker name/config must stay dev-specific
          #   .env / .dev.vars                    - dev-specific secrets/config
          #   workers/dealers/dealers.config.js   - CHECK: excluded to match the reverse
          #                                          (dev->prod) sync's own exclude list. If you
          #                                          actually want dev's dealer list reset to
          #                                          match prod as part of this run, remove this
          #                                          line deliberately rather than by accident.
          rsync -av --delete \
            --exclude='.git/' \
            --exclude='node_modules/' \
            --exclude='.github/' \
            --exclude='wrangler.toml' \
            --exclude='.env' \
            --exclude='.dev.vars' \
            --exclude='workers/dealers/dealers.config.js' \
            prod/ dev/

      - name: Check for changes
        id: changes
        run: |
          cd dev
          git diff --quiet && echo "changed=false" >> "$GITHUB_OUTPUT" || echo "changed=true" >> "$GITHUB_OUTPUT"

      - name: Commit and push to dev
        if: steps.changes.outputs.changed == 'true'
        run: |
          cd dev
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "chore: one-off mirror sync from e-fficient-finance-widget (prod)"

          # Rebase-and-retry, same pattern used across the other sync
          # workflows — protects against a manual push landing on dev's
          # main between checkout and push.
          for attempt in 1 2 3; do
            git fetch origin main
            if git rebase origin/main; then
              if git push origin main; then
                echo "✅ Pushed successfully (attempt $attempt)."
                break
              fi
            else
              echo "❌ Rebase produced a real conflict — needs manual resolution."
              git rebase --abort
              exit 1
            fi

            if [ "$attempt" = "3" ]; then
              echo "❌ Push still failing after 3 attempts — giving up."
              exit 1
            fi
            echo "⚠️  Push rejected (attempt $attempt), retrying after rebase..."
            sleep 3
          done

      - name: Report outcome
        if: always()
        run: |
          if [ "${{ steps.changes.outputs.changed }}" = "true" ]; then
            echo "✅ dev now mirrors prod (excluding .github/, wrangler.toml, .env, .dev.vars, dealers.config.js)."
          else
            echo "ℹ️  No differences found — dev already matched prod. Nothing pushed."
          fi

